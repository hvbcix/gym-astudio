---
import { Image } from 'astro:assets';
import machinesImg from '../assets/sala-maszyny.jpg';
import cardioImg from '../assets/strefa-cardio.jpg';
import classesImg from '../assets/sala-zajec.jpg';
import { site } from '../data/site';

const stats = [
  { value: String(site.schedule.length), label: 'zajęć grupowych w tygodniu' },
  { value: `${site.rating.value}★`, label: 'średnia ocen w Google' },
  { value: '1:1', label: 'treningi personalne' },
  { value: 'Pn–Pt', label: 'rano i po południu' },
];
---

<section id="oferta" class="bg-coal">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-end md:gap-12">
      <div>
        <p class="eyebrow">Oferta</p>
        <h2 class="mt-4 font-display text-4xl font-medium leading-tight md:text-5xl">
          Wszystko, czego potrzebujesz. Nic, co rozprasza.
        </h2>
      </div>
      <p class="text-lg text-paper/70">
        A STUDIO to miejsce dla kobiet i mężczyzn, początkujących i zaawansowanych. Dobry sprzęt, małe grupy i trenerzy, którzy wymagają, ale zawsze pomogą.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:h-[40rem] md:grid-cols-3 md:grid-rows-2">
      <figure class="relative overflow-hidden rounded-3xl md:col-span-2">
        <Image src={machinesImg} alt="Strefa maszyn i suwnica Smitha" class="aspect-[4/3] size-full object-cover md:aspect-auto" widths={[640, 960, 1360]} sizes="(min-width: 768px) 760px, 100vw" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-ink/80 px-4 py-1.5 text-xs uppercase tracking-[0.2em] text-gold-light backdrop-blur">Strefa maszyn</figcaption>
      </figure>
      <figure class="relative overflow-hidden rounded-3xl md:row-span-2">
        <Image src={cardioImg} alt="Strefa cardio z bieżnią i rowerami na drewnianej podłodze" class="aspect-[3/4] size-full object-cover md:aspect-auto" widths={[480, 765]} sizes="(min-width: 768px) 380px, 100vw" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-ink/80 px-4 py-1.5 text-xs uppercase tracking-[0.2em] text-gold-light backdrop-blur">Cardio</figcaption>
      </figure>
      <figure class="relative overflow-hidden rounded-3xl">
        <Image src={classesImg} alt="Jasna sala do zajęć grupowych z drewnianą podłogą" class="aspect-[4/3] size-full object-cover md:aspect-auto" widths={[480, 960]} sizes="(min-width: 768px) 380px, 100vw" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-ink/80 px-4 py-1.5 text-xs uppercase tracking-[0.2em] text-gold-light backdrop-blur">Sala zajęć</figcaption>
      </figure>
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-gold/25 bg-gold/25">
        {
          stats.map((s) => (
            <div class="flex flex-col justify-end bg-ink p-5">
              <dt class="order-2 mt-1.5 text-[0.65rem] uppercase tracking-[0.18em] text-paper/60">{s.label}</dt>
              <dd class="font-display text-3xl font-medium text-gold-light">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-paper/10 bg-paper/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.offer.map((item, i) => (
          <li class="bg-coal p-7">
            <span class="font-display text-sm text-gold-light">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-medium uppercase tracking-[0.12em]">{item.title}</h3>
            <p class="mt-3 text-paper/65">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
