---
import { Image } from 'astro:assets';
import cardioImg from '../assets/sala-cardio.png';
import { site } from '../data/site';

const stats = [
  { value: String(site.schedule.length), label: 'zajęć grupowych w tygodniu' },
  { value: `${site.rating.value}★`, label: 'średnia ocen w Google' },
  { value: '1:1', label: 'treningi personalne' },
  { value: 'Pn–Pt', label: 'rano i po południu' },
];
---

<section id="oferta" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
  <div class="grid gap-12 md:grid-cols-[1fr_1.1fr] md:items-end">
    <div>
      <p class="eyebrow text-ink/55">Oferta</p>
      <h2 class="mt-4 font-display text-4xl font-medium leading-tight md:text-5xl">
        Wszystko, czego potrzebujesz. Nic, co rozprasza.
      </h2>
    </div>
    <p class="text-lg text-ink/70">
      A STUDIO to miejsce dla kobiet i mężczyzn, początkujących i zaawansowanych. Dobry sprzęt, małe grupy i trenerzy, którzy wymagają, ale zawsze pomogą.
    </p>
  </div>

  <div class="mt-14 grid gap-4 sm:grid-cols-[1fr_1.6fr]">
    <Image src={cardioImg} alt="Strefa cardio z bieżnią i rowerami" class="aspect-[4/3] w-full rounded-3xl object-cover sm:aspect-auto sm:h-80" widths={[262]} quality={90} />
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl bg-paper/15 text-paper sm:h-80">
      {
        stats.map((s) => (
          <div class="flex flex-col justify-end bg-ink p-6 md:p-8">
            <dt class="order-2 mt-2 text-xs uppercase tracking-[0.2em] text-paper/60">{s.label}</dt>
            <dd class="font-display text-4xl font-medium md:text-5xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-3">
    {
      site.offer.map((item, i) => (
        <li class="bg-paper p-7">
          <span class="font-display text-sm text-ink/40">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-lg font-medium uppercase tracking-[0.12em]">{item.title}</h3>
          <p class="mt-3 text-ink/70">{item.text}</p>
        </li>
      ))
    }
  </ol>
</section>
