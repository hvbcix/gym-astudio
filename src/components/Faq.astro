---
import { site } from '../data/site';
---

<section id="faq" class="bg-ink">
  <div class="mx-auto max-w-3xl px-5 py-20 md:py-28">
    <p class="eyebrow text-center">Pytania</p>
    <h2 class="mt-4 text-center font-display text-4xl font-medium md:text-5xl">Zanim przyjdziesz</h2>

    <div class="mt-12 divide-y divide-paper/10 border-y border-paper/10">
      {
        site.faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium">
              {item.q}
              <span class="text-2xl font-light text-gold-light transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-paper/65">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
