---
import { site } from '../data/site';

const formatRanges = (ranges: [string, string][]) =>
  ranges.length ? ranges.map(([a, b]) => `${a}–${b}`).join(', ') : 'Zamknięte';
---

<section id="kontakt" class="bg-coal py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Kontakt i dojazd</p>
      <h2 class="mt-4 font-display text-4xl font-medium md:text-5xl">Wpadnij na pierwszy trening</h2>
      <p class="mt-5 max-w-md text-paper/70">
        Zadzwoń albo napisz. Pokażemy salę, dobierzemy zajęcia i odpowiemy na każde pytanie.
      </p>

      <dl class="mt-10 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="eyebrow text-gold-light/80">Adres</dt>
          <dd class="mt-2">{site.address.street}<br />{site.address.postalCode} {site.address.city}</dd>
        </div>
        <div>
          <dt class="eyebrow text-gold-light/80">Telefon</dt>
          <dd class="mt-2"><a href={site.phoneHref} class="hover:underline">{site.phone}</a></dd>
        </div>
        <div>
          <dt class="eyebrow text-gold-light/80">E-mail</dt>
          <dd class="mt-2 break-all"><a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a></dd>
        </div>
        <div>
          <dt class="eyebrow text-gold-light/80">Social media</dt>
          <dd class="mt-2 flex gap-4">
            <a href={site.instagram} target="_blank" rel="noopener" class="hover:underline">Instagram</a>
            <a href={site.facebook} target="_blank" rel="noopener" class="hover:underline">Facebook</a>
          </dd>
        </div>
      </dl>

      <div class="mt-10">
        <h3 class="eyebrow flex items-center gap-3">
          Godziny otwarcia
          <span class="inline-flex items-center gap-2 normal-case tracking-normal text-paper/80" data-open-status>
            <span class="size-2 rounded-full bg-paper/40" data-open-dot></span><span data-open-text></span>
          </span>
        </h3>
        <table class="mt-4 w-full max-w-md text-sm">
          <tbody>
            {
              site.openingHours.map((d) => (
                <tr class="border-b border-paper/10" data-hours-day={d.day}>
                  <th scope="row" class="py-2.5 text-left font-normal text-paper/70">{d.label}</th>
                  <td class:list={['py-2.5 text-right', !d.ranges.length && 'text-paper/45']}>{formatRanges(d.ranges)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={site.phoneHref} class="btn-gold">Zadzwoń</a>
        <a href={site.instagram} target="_blank" rel="noopener" class="btn-ghost">Napisz na Instagramie</a>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div class="min-h-80 flex-1 overflow-hidden rounded-3xl bg-graphite">
        <iframe
          src={site.mapsEmbed}
          title="Mapa dojazdu do A STUDIO"
          class="size-full min-h-80 grayscale invert-[0.9] hue-rotate-180"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <a href={site.mapsDirections} target="_blank" rel="noopener" class="btn-ghost">Wyznacz trasę w Google Maps</a>
    </div>
  </div>
</section>
