---
import Logo from './Logo.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-gold/20 bg-black pb-28 pt-10 text-paper/60 md:pb-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-5 text-sm md:flex-row">
    <Logo class="h-8" />
    <p>{site.address.street}, {site.address.postalCode} {site.address.city} · {site.phone}</p>
    <p>© {year} {site.name} by {site.owner}</p>
  </div>
</footer>
