---
import { Image } from 'astro:assets';
import heroImg from '../assets/sala-wolne-ciezary.png';
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-14 md:grid-cols-[1.1fr_1fr] md:pb-24 md:pt-20">
    <div>
      <p class="eyebrow text-paper/60">Siłownia · Fitness · Mosina</p>
      <h1 class="mt-5 font-display text-5xl font-medium leading-[1.02] sm:text-6xl lg:text-7xl">
        Siła rodzi się <em class="font-medium">w&nbsp;dobrym</em> towarzystwie.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-paper/75">
        Kameralna siłownia przy Głównej w Mosinie. Wolne ciężary, cardio, zajęcia grupowe i trenerzy, którzy znają Cię z imienia.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={site.phoneHref} class="btn-light">Umów pierwszy trening</a>
        <a href="#grafik" class="btn-ghost-light">Zobacz grafik zajęć</a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-paper/80">
        <a href={site.googleReviews} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-paper">
          <span class="text-amber-300" aria-hidden="true">★★★★★</span>
          <span><strong class="font-semibold text-paper">{site.rating.value}</strong> w Google ({site.rating.count} opinii)</span>
        </a>
        <span class="hidden h-4 w-px bg-paper/25 sm:block"></span>
        <span class="inline-flex items-center gap-2" data-open-status>
          <span class="size-2 rounded-full bg-paper/40" data-open-dot></span>
          <span data-open-text>Pon–Pt 8–10 i 16–20</span>
        </span>
      </div>
    </div>

    <div class="relative">
      <div class="absolute -inset-6 -z-0 rounded-[2.5rem] border border-paper/10 max-md:hidden"></div>
      <Image
        src={heroImg}
        alt="Sala z wolnymi ciężarami w A STUDIO"
        class="relative aspect-[4/3] w-full rounded-3xl object-cover"
        loading="eager"
        widths={[555]}
        quality={90}
      />
      <div class="absolute -bottom-5 left-5 rounded-2xl bg-paper px-5 py-3 text-ink shadow-xl">
        <p class="font-display text-2xl font-medium leading-none">{site.address.street}</p>
        <p class="mt-1 text-xs uppercase tracking-[0.2em] text-ink/60">{site.address.city}</p>
      </div>
    </div>
  </div>
</section>
