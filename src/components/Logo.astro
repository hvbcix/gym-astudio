---
import { Image } from 'astro:assets';
import logoHorizontal from '../assets/logo-horizontal.png';
import logoFull from '../assets/logo.png';

interface Props {
  variant?: 'horizontal' | 'full';
  class?: string;
}
const { variant = 'horizontal', class: className = '' } = Astro.props;
const src = variant === 'full' ? logoFull : logoHorizontal;
---

<Image src={src} alt="A STUDIO by Ania Iskierska" class={`w-auto ${className}`} widths={[0.25, 0.5, 1].map((f) => Math.round(src.width * f))} sizes="200px" />
